{
  "name": "kellnr-website",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p build-only",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "generate:rss": "node scripts/generate-rss.mjs",
    "build-only": "npm run generate:rss && vite build",
    "type-check": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "run-s format:check lint type-check \"test:unit -- --run\" build test:e2e"
  },
  "dependencies": {
    "feather-icons": "^4.29.0",
    "highlight.js": "^11.12.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.45",
    "vue-feather": "^2.0.0",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@rushstack/eslint-patch": "^1.16.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "jsdom": "^31.0.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  },
  "allowScripts": {
    "core-js": false,
    "fsevents": false
  }
}
