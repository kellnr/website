{
  "name": "kellnr-website",
  "version": "0.0.0",
  "scripts": {
    "dev": "vite",
    "build": "run-p build-only",
    "preview": "vite preview",
    "test:unit": "vitest",
    "generate:rss": "node scripts/generate-rss.mjs",
    "build-only": "npm run generate:rss && vite build",
    "type-check": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "feather-icons": "^4.29.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-carousel": "^0.18.0",
    "vue-feather": "^2.0.0",
    "vue-router": "^4.5.0",
    "vue3-highlightjs": "^1.0.5"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.16.1",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^9.24.0",
    "eslint-plugin-vue": "^10.12.0",
    "jsdom": "^26.0.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.8.8",
    "typescript": "^5.8.3",
    "vite": "^6.2.5",
    "vitest": "^3.1.1",
    "vue-tsc": "^3.3.14"
  }
}
